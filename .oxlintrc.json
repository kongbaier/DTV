{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // React Compiler (Rules of React) 相关规则由 oxlint 原生实现，随 react 插件启用。
  // 本项目已在 vite.config.ts 开启 React Compiler（oxc），这里的规则用于在编译前
  // 暴露会触发 compiler bail-out / 违规 hook 用法的代码。
  // 规则清单可参考 node_modules/oxlint/configuration_schema.json 或 oxlint 文档。
  "plugins": ["react"],
  "ignorePatterns": ["dist/**", "build/**", "node_modules/**", "src-tauri/**"],
  "rules": {
    // Rules of React：hook 必须无条件、按固定顺序在顶层调用
    "react/rules-of-hooks": "error",
    // 记忆化劝导（useCallback/useMemo 依赖、“changes every render”提示）已由
    // React Compiler 自动记忆化接管，关闭；但 compiler 不会替 useEffect 补依赖，
    // effect 缺依赖仍是正确性契约，用 exhaustive-effect-dependencies 单独保留。
    "react/exhaustive-deps": "off",
    "react/exhaustive-effect-dependencies": "warn",
    // 以下为 React Compiler / Rules-of-React 的细化规则，先以 warn 观察，修复后可视需要提为 error
    "react/purity": "warn",
    "react/refs": "warn",
    "react/immutability": "warn",
    "react/set-state-in-render": "warn",
    "react/set-state-in-effect": "warn",
    "react/no-unstable-nested-components": "warn",
    "react/preserve-manual-memoization": "warn",
    "react/memo-dependencies": "warn"
  }
}
